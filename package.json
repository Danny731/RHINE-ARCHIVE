{
  "name": "rhine-archive",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "node scripts/tauri.mjs dev",
    "package": "node scripts/package-update.mjs",
    "package:macos": "node scripts/package-macos.mjs",
    "test:webkit": "playwright test --config playwright.webkit.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sample": "node scripts/make-sample.mjs",
    "test:fixtures": "node scripts/make-test-pdfs.mjs && node scripts/make-toc-fixtures.mjs",
    "format": "prettier --write src scripts tests *.ts *.json",
    "release:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-release.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "lucide-react": "^1.46.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.1"
  }
}
