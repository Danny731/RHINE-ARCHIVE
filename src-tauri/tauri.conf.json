{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RHINE ARCHIVE",
  "mainBinaryName": "RHINE ARCHIVE",
  "version": "0.3.0",
  "identifier": "com.pagewise.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "莱茵档案 · Rhine Archive",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#e8e5e1",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' blob: data:; object-src 'none'"
    }
  },
  "bundle": {
    "publisher": "RHINE ARCHIVE",
    "active": true,
    "targets": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Rhine Archive - Offline textbook PDF reader",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF document",
        "description": "使用莱茵档案阅读 PDF",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Danny731/RHINE-ARCHIVE/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDMEI2Q0JFM0FGQkM0RQpSV1JPdksvank3YkFEalhnQjZKMTFHR1kyME1seEhieGMwWEMvd2hBSGQxTDRLdW5HWVRMRURIago="
    }
  }
}
